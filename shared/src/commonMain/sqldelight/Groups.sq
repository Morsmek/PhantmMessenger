CREATE TABLE groups (
    id TEXT NOT NULL PRIMARY KEY,
    name TEXT NOT NULL,
    key_version INTEGER NOT NULL DEFAULT 1,
    group_key BLOB NOT NULL,
    created_at_ms INTEGER NOT NULL
);

CREATE TABLE group_members (
    group_id TEXT NOT NULL REFERENCES groups(id) ON DELETE CASCADE,
    member_id TEXT NOT NULL,
    joined_at_ms INTEGER NOT NULL,
    PRIMARY KEY (group_id, member_id)
);

insertGroup:
INSERT INTO groups(id, name, key_version, group_key, created_at_ms)
VALUES (:id, :name, :key_version, :group_key, :created_at_ms);

selectGroupById:
SELECT * FROM groups WHERE id = :id;

updateGroupKey:
UPDATE groups SET group_key = :group_key, key_version = key_version + 1 WHERE id = :id;

deleteGroup:
DELETE FROM groups WHERE id = :id;

insertMember:
INSERT OR IGNORE INTO group_members(group_id, member_id, joined_at_ms)
VALUES (:group_id, :member_id, :joined_at_ms);

selectMembersByGroup:
SELECT member_id FROM group_members WHERE group_id = :group_id;

deleteMember:
DELETE FROM group_members WHERE group_id = :group_id AND member_id = :member_id;

deleteAllMembers:
DELETE FROM group_members WHERE group_id = :group_id;
